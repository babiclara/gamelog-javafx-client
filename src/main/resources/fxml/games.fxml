<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.gamelogclient.controller.GamesController">

    <top>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="10" left="15"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="GameLog" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="userLabel" style="-fx-text-fill: gray;"/>
            </HBox>

            <HBox spacing="8">
                <Button fx:id="refreshButton" text="↻ Refresh" onAction="#handleRefresh"/>
                <Button fx:id="newButton" text="+ New Game" onAction="#handleNew" disable="true"/>
                <Button fx:id="editButton" text="✎ Edit" onAction="#handleEdit" disable="true"/>
                <Button fx:id="deleteButton" text="🗑 Delete" onAction="#handleDelete" disable="true"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="backupButton" text="⬇ Backup" onAction="#handleBackup" disable="true"/>
                <Button fx:id="restoreButton" text="⬆ Restore" onAction="#handleRestore" disable="true"/>
                <Button fx:id="logoutButton" text="Logout" onAction="#handleLogout"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="5">
            <padding>
                <Insets top="0" right="15" bottom="15" left="15"/>
            </padding>

            <TableView fx:id="gamesTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idCol" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="titleCol" text="Title" prefWidth="250"/>
                    <TableColumn fx:id="developerCol" text="Developer" prefWidth="150"/>
                    <TableColumn fx:id="platformCol" text="Platform" prefWidth="100"/>
                    <TableColumn fx:id="statusCol" text="Status" prefWidth="120"/>
                    <TableColumn fx:id="ratingCol" text="Rating" prefWidth="70"/>
                    <TableColumn fx:id="hoursCol" text="Hours" prefWidth="70"/>
                </columns>
            </TableView>

            <Label fx:id="statusLabel" style="-fx-text-fill: gray;"/>
        </VBox>
    </center>

</BorderPane>