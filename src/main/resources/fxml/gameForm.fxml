<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="hr.algebra.gamelogclient.controller.GameFormController"
            prefWidth="700" prefHeight="650">

    <top>
        <VBox spacing="5">
            <padding><Insets top="15" right="20" bottom="10" left="20"/></padding>
            <Label fx:id="titleLabel" text="New Game" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <Label text="Fields marked * are required." style="-fx-text-fill: gray; -fx-font-size: 11px;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox>
                <padding><Insets top="0" right="20" bottom="10" left="20"/></padding>

                <GridPane hgap="10" vgap="10">

                    <Label text="Title *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="titleField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Developer" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="developerField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Publisher" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="publisherField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Release Year" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Spinner fx:id="releaseYearSpinner" GridPane.rowIndex="3" GridPane.columnIndex="1" editable="true"/>

                    <Label text="Genre *" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="genreCombo" GridPane.rowIndex="4" GridPane.columnIndex="1" maxWidth="Infinity"/>

                    <Label text="Platform *" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="platformCombo" GridPane.rowIndex="5" GridPane.columnIndex="1" maxWidth="Infinity"/>

                    <Label text="Status *" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="statusCombo" GridPane.rowIndex="6" GridPane.columnIndex="1" maxWidth="Infinity"/>

                    <Label text="Difficulty" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="difficultyCombo" GridPane.rowIndex="7" GridPane.columnIndex="1" maxWidth="Infinity"/>

                    <Label text="Hours Played" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
                    <Spinner fx:id="hoursSpinner" GridPane.rowIndex="8" GridPane.columnIndex="1" editable="true"/>

                    <Label text="Completion %" GridPane.rowIndex="9" GridPane.columnIndex="0"/>
                    <Spinner fx:id="completionSpinner" GridPane.rowIndex="9" GridPane.columnIndex="1" editable="true"/>

                    <Label text="Rating (1-5)" GridPane.rowIndex="10" GridPane.columnIndex="0"/>
                    <Spinner fx:id="ratingSpinner" GridPane.rowIndex="10" GridPane.columnIndex="1" editable="true"/>

                    <Label text="Started Date" GridPane.rowIndex="11" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="startedDatePicker" GridPane.rowIndex="11" GridPane.columnIndex="1" maxWidth="Infinity"/>

                    <Label text="Finished Date" GridPane.rowIndex="12" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="finishedDatePicker" GridPane.rowIndex="12" GridPane.columnIndex="1" maxWidth="Infinity"/>

                    <Label text="Review" GridPane.rowIndex="13" GridPane.columnIndex="0"/>
                    <TextArea fx:id="reviewArea" GridPane.rowIndex="13" GridPane.columnIndex="1" prefRowCount="3"/>

                    <Label text="Personal Notes" GridPane.rowIndex="14" GridPane.columnIndex="0"/>
                    <TextArea fx:id="notesArea" GridPane.rowIndex="14" GridPane.columnIndex="1" prefRowCount="3"/>

                    <columnConstraints>
                        <javafx.scene.layout.ColumnConstraints minWidth="120" prefWidth="120"/>
                        <javafx.scene.layout.ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                </GridPane>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <VBox spacing="8">
            <padding><Insets top="10" right="20" bottom="15" left="20"/></padding>
            <Label fx:id="errorLabel" style="-fx-text-fill: red;" wrapText="true"/>
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancel"/>
                <Button fx:id="saveButton" text="Save" onAction="#handleSave" defaultButton="true"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>